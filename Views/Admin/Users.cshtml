@model List<SeyitnameWebSite.Data.User>
@{
    ViewData["Title"] = "Üye Yönetimi - Admin Paneli";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="text-center mb-5 portfolio-item">
                <h1 class="hero-title mb-2">Admin Paneli</h1>
                <p class="hero-subtitle">Kayıtlı Üyeleri Yönet</p>
            </div>

            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info" role="alert">
                    Henüz kayıtlı üye yok.
                </div>
                <a href="/" class="btn btn-outline-primary">Anasayfaya Dön</a>
            }
            else
            {
                <div class="card-custom portfolio-item">
                    <div class="table-responsive">
                        <table class="table table-hover table-dark mb-0">
                            <thead class="table-header-custom">
                                <tr>
                                    <th class="gradient-text">Kullanıcı Adı</th>
                                    <th class="gradient-text">Ad-Soyad</th>
                                    <th class="gradient-text">E-posta</th>
                                    <th class="gradient-text">Üye Olma Tarihi</th>
                                    <th class="gradient-text">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr class="border-bottom border-secondary align-middle">
                                        <td>
                                            <strong>@user.UserName</strong>
                                        </td>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>@user.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <a href="/Admin/UserDetails/@user.Id" class="btn btn-sm btn-info me-2" title="Detayları Gör">Görüntüle</a>
                                            <a href="/Admin/ManageUserRoles?id=@user.Id" class="btn btn-sm btn-warning me-2" title="Rolleri Düzenle">Roller</a>
                                            <a href="/Admin/ConfirmDeleteUser?id=@user.Id" class="btn btn-sm btn-danger" title="Sil">Sil</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted">
                            Toplam @Model.Count Kayıtlı Üye
                        </p>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="/" class="btn btn-outline-primary">Anasayfaya Dön</a>
                </div>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null) {
    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
}

<style>
.table-header-custom {
    background-color: rgba(102, 126, 234, 0.1);
}

.table-hover tbody tr:hover {
    background-color: rgba(102, 126, 234, 0.08) !important;
}
</style>

