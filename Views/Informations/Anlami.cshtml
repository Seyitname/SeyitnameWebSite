@{
    ViewData["Title"] = "Anlamı - Seyitname";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-5 portfolio-item">
                <h1 class="hero-title mb-3">Seyitname Nedir?</h1>
                <p class="hero-subtitle">Adının Anlamı</p>
            </div>

            <div class="card-custom portfolio-item">
                <h3 class="gradient-text mb-4">Anlamı</h3>
                <p class="text-muted mb-3 lh-lg">
                    <strong>Seyitname</strong> sözcüğünün anlamı gayet basit olmakla birlikte sahibinin ismini belli etmektedir.
                </p>
                <p class="text-muted mb-3 lh-lg">
                    Türkçeye çevirdiğimizde "Seyit isim" diye çevrilmektedir. Bunu anlamlandırdığımızda "İsim Seyit" olarak karşımıza çıkmaktadır.
                </p>
                <div class="border-top border-secondary pt-4">
                    <h5 class="gradient-text">Kısaca:</h5>
                    <p class="text-muted">
                        <strong>Seyit</strong> + <strong>Name</strong> (İsim) = <strong>Seyitname</strong>
                    </p>
                </div>
            </div>

            <div class="text-center mt-5">
                <a href="/Informations/Kimdir" class="btn btn-outline-primary">Kimdir? →</a>
            </div>
        </div>
    </div>
</div>
