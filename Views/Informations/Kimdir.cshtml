@{
    ViewData["Title"] = "Kimdir - Seyitname";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-5 portfolio-item">
                <h1 class="hero-title mb-3">Seyit Kimdir?</h1>
                <p class="hero-subtitle">Kişisel Bilgiler</p>
            </div>

            <div class="card-custom portfolio-item">
                <p class="text-muted mb-4 lh-lg">
                    <strong>Seyitname</strong>, birçok oyunda yer alan nadir nickname'lerden birisidir.
                    Başlangıcı 5 yıl öncesine dayanmakla birlikte PUBG, PUBG Mobile, Roblox, Discord vb. alanlarda yer almıştır.
                </p>
                
                <h4 class="gradient-text mb-3">Bulunduğu Platformlar</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3" style="background: rgba(102, 126, 234, 0.1); border-radius: 8px; border-left: 3px solid var(--primary-color);">
                            <h6 class="text-light mb-2">Oyunlar</h6>
                            <p class="text-muted small mb-0">PUBG, PUBG Mobile, Roblox</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3" style="background: rgba(240, 147, 251, 0.1); border-radius: 8px; border-left: 3px solid var(--accent-color);">
                            <h6 class="text-light mb-2">Sosyal</h6>
                            <p class="text-muted small mb-0">Discord, YouTube, Twitch</p>
                        </div>
                    </div>
                </div>

                <div class="border-top border-secondary pt-4">
                    <p class="text-muted">
                        Daha fazla bilgi için diğer bölümleri ziyaret edebilirsiniz.
                    </p>
                </div>
            </div>

            <div class="text-center mt-5">
                <a href="/Informations/Tarihi" class="btn btn-outline-primary">Tarihi →</a>
            </div>
        </div>
    </div>
</div>
