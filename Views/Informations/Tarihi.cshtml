@{
    ViewData["Title"] = "Tarihi - Seyitname";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-5 portfolio-item">
                <h1 class="hero-title mb-3">Seyit'in Tarihi</h1>
                <p class="hero-subtitle">Başarı Yolculuğu</p>
            </div>

            <div class="card-custom portfolio-item">
                <h3 class="gradient-text mb-4">Geçmiş ve Deneyim</h3>
                
                <div class="timeline">
                    <div class="mb-4 pb-3 border-bottom border-secondary">
                        <h6 class="gradient-text">2019</h6>
                        <p class="text-muted mb-0">İlk olarak PUBG Mobile isimli oyunda kullanılmaya başlandı.</p>
                    </div>
                    
                    <div class="mb-4 pb-3 border-bottom border-secondary">
                        <h6 class="gradient-text">Yayılım</h6>
                        <p class="text-muted mb-0">Zamanla diğer platformlara da yayılmış ve tanınır hale gelmiştir.</p>
                    </div>
                    
                    <div class="mb-4 pb-3 border-bottom border-secondary">
                        <h6 class="gradient-text">Web Geliştirme</h6>
                        <p class="text-muted mb-0">Son dönemde web geliştirme alanına yönelmiş ve bu portföy sayfasını oluşturmuştur.</p>
                    </div>
                    
                    <div class="mb-4">
                        <h6 class="gradient-text">Günümüz</h6>
                        <p class="text-muted mb-0">Sürekli gelişim ve öğrenme ile kariyerini ilerletmektedir.</p>
                    </div>
                </div>

                <div class="border-top border-secondary pt-4 mt-4">
                    <p class="text-muted small">
                        Bu portföy sayfası Seyitname'in yeteneklerini ve çalışmalarını sergilemektedir.
                    </p>
                </div>
            </div>

            <div class="text-center mt-5">
                <a href="/Informations/Ozellikleri" class="btn btn-outline-primary">Özellikleri →</a>
            </div>
        </div>
    </div>
</div>
